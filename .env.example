PORT=4000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/flowterminal?retryWrites=true&w=majority
MONGODB_DATABASE=flowterminal
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
DEFAULT_SYMBOL=BTCUSDT

# The three specialists and the manager each use their own Gemini project pool.
# Format each entry as project-id|API-key; separate two projects with a comma.
# Use distinct project IDs if you want the app's quota tracking to treat them
# independently. Multiple keys from one project share that project's quota.
ORDERFLOW_AI_MODE=gemini
GEMINI_SPECIALIST_MODEL=gemini-3.5-flash-lite
GEMINI_MANAGER_MODEL=gemini-3.8-flash
GEMINI_SMC_CREDENTIALS=project-a|paste-key-here,project-b|paste-key-here
GEMINI_ICT_CREDENTIALS=project-c|paste-key-here,project-d|paste-key-here
GEMINI_ORDERFLOW_CREDENTIALS=project-e|paste-key-here,project-f|paste-key-here
GEMINI_MANAGER_CREDENTIALS=project-g|paste-key-here,project-h|paste-key-here

# Optional quota overrides. Leave at 0 to use conservative defaults based on
# the selected model and the limits shown in AI Studio. Switch occurs before
# the configured project's daily/minute budget is consumed; HTTP 429 also
# triggers fallback to the next credential.
GEMINI_REQUESTS_PER_MINUTE_PER_PROJECT=0
GEMINI_REQUESTS_PER_DAY_PER_PROJECT=0

# Legacy single-key fallback. Prefer the role-specific pools above.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional alternate providers for ORDERFLOW_AI_MODE=ensemble. Keep secrets
# in backend/.env only; never place them in frontend code.
GROQ_API_KEY=
GROQ_MODEL=
# Optional Ollama. Install it on the backend machine, then pull this model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
